{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".nuxt",
    "**/.nuxt",
    ".output",
    "**/.output",
    "dist",
    "**/dist",
    "coverage",
    "**/coverage",
    "playwright-report",
    "**/playwright-report",
    "test-results",
    "**/test-results"
  ]
}
